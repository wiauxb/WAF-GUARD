# Copy to .env and fill in. Every variable here is consumed by docker-compose.yaml
# and passed to backend_na, where it is read by backend/src/shared/config.py.

# Neo4j Configuration
# The host is the compose service name; it is reachable from the host at localhost:7687.
NEO4J_URL=bolt://neo4j_na:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-password>

# PostgreSQL Configuration
POSTGRES_HOST=postgres_na
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=<your-password>
# Created by the postgres image on first start; the backend sees it as POSTGRES_DB_CWAF.
POSTGRES_DB=waf_guard_db

# Service URLs
WAF_URL=http://waf_na:8000

# Backend
# Signs the JWTs handed out by /api/v1/auth. Must not be empty.
JWT_SECRET_KEY=<a-long-random-string>
# Rows per batch when deleting a configuration's directives from Postgres.
DELETE_BATCH_SIZE=1000

# LLM (chatbot). Leave blank to run everything except the /chatbot page.
OPENAI_API_KEY=sk-...

# Optional — where the browser reaches the API. frontend/waf-react/lib/api.ts already
# defaults to http://localhost:8000/api/v1, which matches the published port, so this
# only needs setting if you move the backend or serve the UI from another machine.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api/v1
